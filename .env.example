# ============================================================================
# ENVIRONMENT SETTINGS
# Copy this file to ".env" (same folder) and fill in your values.
# The real .env file is NOT uploaded to GitHub (it is listed in .gitignore),
# so passwords stay private.
# ============================================================================

# DATABASE_URL: where the MySQL database is.
#   Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
#
#   XAMPP on your own PC (default user "root" with no password):
DATABASE_URL="mysql://root:@localhost:3306/library_db"
#
#   Aiven cloud MySQL (copy the "Service URI" from the Aiven console):
#   DATABASE_URL="mysql://avnadmin:YOUR_PASSWORD@your-service.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED"

# DB_SSL_CA: (cloud only, recommended) Aiven's CA certificate, so the app can verify
# it is really talking to your Aiven server. Paste the whole ca.pem content.
# Leave empty for XAMPP.
DB_SSL_CA=""

# JWT_SECRET: secret key used to sign login tokens. Use a long random text in production.
# Example to generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-secret"

# VITE_API_URL: (optional) only needed if the front end and back end are hosted separately.
VITE_API_URL=
